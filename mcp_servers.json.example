{
  "servers": [
    {
      "name": "github",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true,
      "expose_route": "github",
      "instructions": "Guidance published in the hub's MCP initialize result; put an upstream server's own usage notes here (see docs/modules/mcp-hub.md)."
    },
    {
      "name": "gitee",
      "transport": "streamable_http",
      "url": "https://api.gitee.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITEE_TOKEN}"
      },
      "enabled": false
    },
    {
      "name": "probe",
      "transport": "stdio",
      "command": "probe",
      "args": ["mcp"],
      "enabled": true,
      "expose_route": "probe"
    }
  ]
}